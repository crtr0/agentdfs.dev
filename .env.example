# Application and PostgreSQL. Copy this file to .env for local development.
APP_BASE_URL=http://127.0.0.1:5173
RESEND_API_KEY=
EMAIL_FROM=AgentDFS <no-reply@your-domain.com>
PORT=8080
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/agentdfs
# Fly MPG's pooled URL is for the app; use its direct URL for migrations.
DIRECT_DATABASE_URL=
DB_POOL_MAX=5
# HTTP Basic Auth password for the /admin dashboard.
ADMIN_SECRET=change-this-secret
CURRENT_SEASON=2026
SEASON_START_AT=2026-09-10T00:20:00Z
SEASON_END_AT=2027-01-11T23:59:59Z

FANTASYNERDS_API_KEY=
FANTASYNERDS_BASE_URL=https://api.fantasynerds.com
FANTASYNERDS_OPERATOR=Yahoo
USE_FIXTURES=true
